--- a/src/packets.c
+++ b/src/packets.c
@@ -1208,6 +1208,15 @@
     if (maxTurnSpeed < 1) {
         maxTurnSpeed = 1;
     }
+#ifdef PLATFORM_VITA
+    /* Vita possession uses an analog stick rather than a recentered mouse.
+     * Its former 14-unit input was almost at the default 15-unit creature
+     * turn cap, so changing stick sensitivity alone could not help.
+     * Apply a Vita-only 3x limit to directly controlled first-person view;
+     * normal creature movement/AI turn limits stay unchanged.
+     * Packet coordinates are still clamped to [-255,255] upstream. */
+    maxTurnSpeed *= 3;
+#endif
     long horizontalTurnSpeed = pckt->pos_x;
     if (horizontalTurnSpeed < -maxTurnSpeed) {
         horizontalTurnSpeed = -maxTurnSpeed;
