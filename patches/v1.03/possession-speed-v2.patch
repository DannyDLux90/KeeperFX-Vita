  * The ordinary Vita pointer is absolute and is not recentered by the
  * engine's LbMouseSetPositionInitial(), so it could rotate a creature forever.
  * Feed the existing first-person packet with a signed, centred stick vector.
- * A modest range leaves the creature's original turning-speed cap effective.
+ * The larger range is paired with a Vita-only 3x possession turn cap;
+ * deadzone and neutral-stick zero output are unchanged.
  */
-#define VITA_POSSESSION_LOOK_MAX 14
+#define VITA_POSSESSION_LOOK_MAX 48
 
 static int vita_possession_axis(unsigned char sample)
 {
@@ -808,6 +809,7 @@
     g_input = &input_vita_impl;
     SYNCLOG("Vita controller RC4: physical L=0x%03x R=0x%03x; creature portraits use owner menu slot",
             SCE_CTRL_LTRIGGER, SCE_CTRL_RTRIGGER);
+    SYNCLOG("Vita possession speed V2: deadzone=30, max=48, turn_cap=3x (TEST)");
 }
 
