+/* net_exchange_gameplay.c — local packet history.
+ * KeeperFX uses packet history for local camera/input processing too.
+ */
+#define LOCAL_PACKET_HISTORY_SIZE 40
+struct LocalPacketHistory {
+    struct Packet entries[LOCAL_PACKET_HISTORY_SIZE];
+};
+static struct LocalPacketHistory s_local_packet_history[MAX_NET_USERS];
+
+void initialize_packet_history(void)
+{
+    memset(s_local_packet_history, 0, sizeof(s_local_packet_history));
+}
+
+void store_packet_history(PlayerNumber player, const struct Packet *packet)
+{
+    if (player < 0 || player >= MAX_NET_USERS || packet == NULL || is_packet_empty(packet))
+        return;
+    struct Packet *entry = &s_local_packet_history[player].entries[packet->turn % LOCAL_PACKET_HISTORY_SIZE];
+    if (!is_packet_empty(entry) && (GameTurnDelta)(entry->turn - packet->turn) > 0)
+        return;
+    *entry = *packet;
+}
+
+const struct Packet *get_history_packet(PlayerNumber player, GameTurn turn)
+{
+    if (player < 0 || player >= MAX_NET_USERS)
+        return NULL;
+    const struct Packet *packet = &s_local_packet_history[player].entries[turn % LOCAL_PACKET_HISTORY_SIZE];
+    if (is_packet_empty(packet) || packet->turn != turn)
+        return NULL;
+    return packet;
+}
