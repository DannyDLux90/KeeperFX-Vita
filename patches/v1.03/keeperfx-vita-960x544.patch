new file mode 100644
index 0000000..c206115
--- /dev/null
+++ b/src/platform/vita_display.h
@@ -0,0 +1,12 @@
+#ifndef KFX_VITA_DISPLAY_H
+#define KFX_VITA_DISPLAY_H
+#define VITA_NATIVE_WIDTH 960
+#define VITA_NATIVE_HEIGHT 544
+#define VITA_NATIVE_MODE "960x544x8"
+static inline int vita_scale_pointer(int position, int native_size, int engine_size)
+{
+    if (native_size <= 1 || engine_size <= 1 || position <= 0) return 0;
+    if (position >= native_size - 1) return engine_size - 1;
+    return position * (engine_size - 1) / (native_size - 1);
+}
+#endif
