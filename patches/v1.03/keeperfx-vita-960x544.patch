new file mode 100644
index 0000000..58ce875
--- /dev/null
+++ b/src/platform/vita_ime.c
@@ -0,0 +1,65 @@
+#ifdef PLATFORM_VITA
+#include "vita_ime.h"
+#include <psp2/kernel/clib.h>
+#include <psp2/ime_dialog.h>
+#include <psp2/sysmodule.h>
+#include <string.h>
+
+static int active, owns_module;
+static SceWChar16 initial_text[22], entered_text[22], title[64];
+static void (*on_complete)(const char *);
+
+int vita_ime_active(void) { return active; }
+
+int vita_ime_open_address(const char *initial, void (*complete)(const char *))
+{
+    if (active || !initial || strlen(initial) >= 22) return 0;
+    owns_module = sceSysmoduleIsLoaded(SCE_SYSMODULE_IME) < 0;
+    if (owns_module && sceSysmoduleLoadModule(SCE_SYSMODULE_IME) < 0) return 0;
+    memset(initial_text, 0, sizeof(initial_text));
+    memset(entered_text, 0, sizeof(entered_text));
+    const char *caption = "IPv4 address (optional :port)";
+    for (unsigned int i = 0; caption[i]; ++i) title[i] = (unsigned char)caption[i];
+    for (unsigned int i = 0; initial[i]; ++i) initial_text[i] = (unsigned char)initial[i];
+    SceImeDialogParam param;
+    sceImeDialogParamInit(&param);
+    param.type = SCE_IME_TYPE_BASIC_LATIN;
+    param.option = SCE_IME_OPTION_NO_AUTO_CAPITALIZATION | SCE_IME_OPTION_NO_ASSISTANCE;
+    param.dialogMode = SCE_IME_DIALOG_DIALOG_MODE_WITH_CANCEL;
+    param.title = title;
+    param.maxTextLength = 21;
+    param.initialText = initial_text;
+    param.inputTextBuffer = entered_text;
+    if (sceImeDialogInit(&param) < 0) {
+        if (owns_module) sceSysmoduleUnloadModule(SCE_SYSMODULE_IME);
+        owns_module = 0;
+        return 0;
+    }
+    on_complete = complete;
+    active = 1;
+    return 1;
+}
+
+void vita_ime_poll(void)
+{
+    if (!active || sceImeDialogGetStatus() != SCE_COMMON_DIALOG_STATUS_FINISHED) return;
+    SceImeDialogResult result;
+    memset(&result, 0, sizeof(result));
+    int accepted = sceImeDialogGetResult(&result) >= 0 && result.result == 0 &&
+                   result.button == SCE_IME_DIALOG_BUTTON_ENTER;
+    char ascii[22] = {0};
+    if (accepted) {
+        for (unsigned int i = 0; i < sizeof(ascii) - 1 && entered_text[i]; ++i) {
+            // Invalid characters are rejected by the address validator.
+            ascii[i] = entered_text[i] < 128 ? (char)entered_text[i] : '?';
+        }
+    }
+    sceImeDialogTerm();
+    if (owns_module) sceSysmoduleUnloadModule(SCE_SYSMODULE_IME);
+    owns_module = 0;
+    active = 0;
+    void (*complete)(const char *) = on_complete;
+    on_complete = NULL;
+    if (accepted && complete) complete(ascii);
+}
+#endif
