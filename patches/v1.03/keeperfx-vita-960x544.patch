diff --git a/src/platform/vita_address.h b/src/platform/vita_address.h
new file mode 100644
index 0000000..c434646
--- /dev/null
+++ b/src/platform/vita_address.h
@@ -0,0 +1,27 @@
+/* Strict IPv4[:port] input validation; no mutation on failure. */
+#ifndef KFX_VITA_ADDRESS_H
+#define KFX_VITA_ADDRESS_H
+static inline int vita_valid_address(const char *text)
+{
+    if (!text) return 0;
+    for (int part = 0; part < 4; ++part) {
+        unsigned int value = 0, digits = 0;
+        while (*text >= '0' && *text <= '9') {
+            if (++digits > 3) return 0;
+            value = value * 10 + (unsigned int)(*text++ - '0');
+        }
+        if (!digits || value > 255) return 0;
+        if (part < 3 && *text++ != '.') return 0;
+    }
+    if (*text == ':') {
+        unsigned int port = 0, digits = 0;
+        ++text;
+        while (*text >= '0' && *text <= '9') {
+            if (++digits > 5) return 0;
+            port = port * 10 + (unsigned int)(*text++ - '0');
+        }
+        if (!digits || port == 0 || port > 65535) return 0;
+    }
+    return *text == '\0';
+}
+#endif
