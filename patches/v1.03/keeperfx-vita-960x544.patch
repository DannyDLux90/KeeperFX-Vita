+void vita_ime_poll(void) { if(ime_close) ime_open=0; }
+void keyboardControl(unsigned int action, TbKeyCode code, TbKeyMods mods, int chr)
+{ (void)mods; (void)chr; key_down[code]=(action==KActn_KEYDOWN); ++key_edges[code]; }
